# ==========================================
# Configuración del Entorno - Cevichería Lucy
# ==========================================

# Entorno de ejecución: development | production | test
NODE_ENV=production

# Puerto del servidor backend HTTP / Socket.IO
PORT=3000

# URI de conexión a MongoDB (local o MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/cevicheria_lucy
# Atlas: mongodb+srv://<usuario>:<password>@cluster.mongodb.net/cevicheria_lucy?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cevicheria_lucy

# MongoDB embebido para demo/pruebas sin instalar MongoDB.
# Solo desarrollo: si es true, ignora MONGODB_URI, levanta una instancia en
# memoria y siembra los datos automáticamente. NO usar en producción.
# USE_EMBEDDED_MONGO=true

# Secreto para firma de tokens JWT (CRÍTICO: cambiar en producción, mín. 32 caracteres)
JWT_SECRET=cambiar-este-secreto-en-produccion-minimo-32-caracteres

# Duración de la sesión JWT (ej. 8h, 24h, 7d)
JWT_EXPIRES_IN=8h

# CORS: orígenes permitidos separados por comas.
# En servicio único: http://localhost:3000
# En desarrollo: http://localhost:5173,http://localhost:3000
# En red local: http://192.168.1.50:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Servicio único de frontend (client/dist) desde Express:
# true por defecto si NODE_ENV=production. Se puede forzar con SERVE_STATIC=true.
SERVE_STATIC=true

# ==========================================
# Variables de Frontend (Vite)
# ==========================================
# IMPORTANTE: Las variables VITE_* son incrustadas en el build estático durante
# la compilación (npm run build -w client).
# Si cambias VITE_API_URL o VITE_SOCKET_URL, DEBES volver a compilar el cliente.
# En servicio único:
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
